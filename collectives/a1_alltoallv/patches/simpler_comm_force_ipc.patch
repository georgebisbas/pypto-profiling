 constexpr uint64_t kDefaultWinSize = 200ULL * 1024 * 1024;
+
+// Escape hatch for boxes where Fabric V2 export intermittently fails with
+// "does not support cross-server communication" (seen on multi-root EP8
+// 910B2). When set to a non-empty value other than "0", skip Fabric and use
+// VMM IPC shareable handles for base + domain windows.
+static bool env_force_ipc_windows() {
+    static const int cached = []() {
+        const char *v = std::getenv("SIMPLER_COMM_FORCE_IPC");
+        const bool on = !(v == nullptr || v[0] == '\0' || (v[0] == '0' && v[1] == '\0'));
+        // stderr always visible in harness attempt logs (LOG_INFO may be filtered).
+        std::fprintf(
+            stderr, "[comm_hccl] SIMPLER_COMM_FORCE_IPC=%s -> %s\n", v == nullptr ? "<unset>" : v,
+            on ? "VMM IPC (skip Fabric)" : "Fabric-first"
+        );
+        return on ? 1 : 0;
+    }();
+    return cached != 0;
+}
 constexpr uint64_t kFabricAnnounceMagic = 0x464142334c334d45ULL;  // "FAB3L3ME"
 constexpr uint32_t kFabricAnnounceVersion = 1;
 
 enum class FabricAttempt { kSuccess, kUnsupported, kError };
 
+// Cross-server / intermittent Fabric export often returns a non-FEATURE_NOT_SUPPORT
+// ACL code (or surfaces later as AICPU 507018). Treat any export failure as
+// "unsupported" so callers fall back to VMM IPC instead of hard-failing.
+static FabricAttempt fabric_export_result(aclError aret, int rank, const char *where) {
+    if (aret == ACL_SUCCESS) return FabricAttempt::kSuccess;
+    if (aret == ACL_ERROR_RT_FEATURE_NOT_SUPPORT) {
+        LOG_INFO("[comm rank %d] %s: Fabric export FEATURE_NOT_SUPPORT; will try IPC", rank, where);
+        return FabricAttempt::kUnsupported;
+    }
+    LOG_WARN(
+        "[comm rank %d] %s: Fabric export -> %d; treating as unsupported for IPC fallback", rank, where,
+        static_cast<int>(aret)
+    );
+    std::fprintf(
+        stderr, "[comm_hccl] rank %d %s: Fabric export acl=%d -> IPC fallback\n", rank, where, static_cast<int>(aret)
+    );
+    return FabricAttempt::kUnsupported;
+}
+
 struct FabricAnnounceFile {
     uint64_t magic = kFabricAnnounceMagic;
     uint32_t version = kFabricAnnounceVersion;
